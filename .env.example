# ============================================================
# CodePilot 配置模板
# 用法：cp .env.example .env.local  然后按需修改
# 原则：所有带「▲必填」的项不填，服务会启动失败（mock 模式除外）
# ============================================================

# ===== 应用 =====
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 统一入口 + SSE 的默认租户
DEFAULT_TENANT_ID=tenant_default

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5434
DB_NAME=codepilot
DB_USER=codepilot
DB_PASSWORD=codepilot_pwd

# ===== Redis（任务队列 / 幂等 / 限流）=====
REDIS_URL=redis://localhost:6381/0
# 留空则退化为进程内 asyncio 队列（单机调试用，不推荐生产）
# 开发单进程内嵌 worker；生产用独立 worker 容器时设为 false
INLINE_WORKER=true
QUEUE_NAME=codepilot:reviews

# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19532
MILVUS_COLLECTION=codepilot_chunks

# ===== LLM =====
# deepseek | openai | mock
# mock = 不调大模型，只跑确定性规则引擎（CI / 离线演示用）
LLM_PROVIDER=deepseek
LLM_API_KEY=                 # ▲必填（mock 模式可空）
LLM_BASE_URL=https://api.deepseek.com/v1
# 两个基础槽：对话类 / 代码类
LLM_MODEL_CHAT=deepseek-chat
LLM_MODEL_CODE=deepseek-chat
# 可选：按 Agent 覆盖（留空 = 回落到上面两个槽）
# 例：审查用强模型、分诊用便宜小模型
LLM_MODEL_REVIEW=
LLM_MODEL_TESTGEN=
LLM_MODEL_TRIAGE=
LLM_MODEL_RAG=
LLM_MODEL_ROUTER=
# 成本估算单价（USD / 1M tokens），换模型记得改，否则预算数字不准
LLM_PRICE_INPUT_PER_M=0.27
LLM_PRICE_OUTPUT_PER_M=1.10
LLM_TIMEOUT_SECONDS=120

# ===== Embedding =====
# hash | local | openai
# hash   = 零依赖的确定性哈希向量（离线演示 / 单测）
# local  = 本地 BGE-M3（需要 requirements-local.txt）
# openai = 任意 OpenAI 兼容 /embeddings 接口
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# local(BGE-M3)=1024；hash=512；必须与实际模型维度一致，改维度需删 Milvus collection
EMBEDDING_DIM=512

# ===== Rerank =====
# none | lexical | cross-encoder
RERANK_BACKEND=lexical
RERANK_MODEL=BAAI/bge-reranker-large
RERANK_TOP_K=8
RETRIEVE_TOP_K=20

# ===== 审查预算与超时（秒 / 次数）=====
REVIEW_DIM_TIMEOUT_SECURITY=90
REVIEW_DIM_TIMEOUT_PERFORMANCE=75
REVIEW_DIM_TIMEOUT_STYLE=45
REVIEW_DIM_TIMEOUT_TEST=45
REVIEW_MAX_STEPS=24
REVIEW_MAX_TOKENS=120000
REVIEW_MAX_COST_USD=0.35

# ===== 代码沙箱 =====
# docker | local | off
SANDBOX_MODE=docker
SANDBOX_IMAGE=codepilot/sandbox:py311
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
# 沙箱工作区根目录（worker 用它 checkout 仓库）
SANDBOX_WORKSPACE_ROOT=./workspace

# ===== 代码仓库 =====
# GitHub token（拉 diff / 写 PR 评论；留空则只做本地审查）
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Webhook 验签密钥（GitHub 后台配置的 Secret）
GITHUB_WEBHOOK_SECRET=
# 允许自动写回 PR 评论
GITHUB_COMMENT_ENABLED=false
# 本地仓库扫描白名单根目录（逗号分隔，防目录穿越）
REPO_LOCAL_ROOTS=./workspace

# ===== JWT =====
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 可观测（可选）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
